# ==========================================
# BuildGuard AI - Unified .gitignore
# ==========================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
venv/
env/
.venv/
ENV/

# Python Testing & Cache
.pytest_cache/
.coverage
htmlcov/
*.coverage.*

# Node.js & Next.js Frontend
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tsbuildinfo

# Large Dataset Files (CubiCasa5K raw & processed partitions)
data/raw/
data/processed/
*.part

# Large Compressed Archives (> 100MB)
colab_package/*.zip
*.tar.gz
*.tgz

# Runtime Storage & User Uploads
storage/*
backend/storage/*
!storage/.gitkeep
!backend/storage/.gitkeep

# SQLite Databases & Lock Files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Environment Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env.docker

# OS & Editor Files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Obsolete / Candidate Weights (Preserving primary floorplan_unet.pt)
backend/models/*.old*
backend/models/*.candidate*
backend/models/*.experiment*
