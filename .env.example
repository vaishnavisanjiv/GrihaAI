# Database
USE_SQLITE=true
SQLITE_URL=sqlite:///./buildguard.db
# Used only when USE_SQLITE=false:
DATABASE_URL=postgresql+psycopg://buildguard:change-me@localhost:5432/buildguard

# Authentication (replace before exposing the API)
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000
STORAGE_PATH=./storage
MAX_FILE_SIZE_MB=20
CV_MODEL_PATH=./models
